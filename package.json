{
  "name": "kce",
  "version": "1.0.0",
  "private": true,
  "description": "KCSimulator",
  "author": "Arc",
  "scripts": {
    "serve": "vite --host 127.0.0.1",
    "build": "vite build",
    "deploy": "npm run electron:build",
    "bgmmake": "node -e \"require('./src/lib/kcdbmaker').runBgmMakeFromNode()\"",
    "clean": "node scripts/clean.cjs",
    "dev": "npm run electron:serve",
    "electron:build": "npm run build && electron-builder --win",
    "electron:serve": "npm run build && electron .",
    "kcmake": "node -e \"require('./src/lib/kcdbmaker').runKCMakeFromNode()\"",
    "kcmakeall": "node -e \"require('./src/lib/kcdbmaker').runAllKCMakeFromNode()\"",
    "semake": "node -e \"require('./src/lib/kcdbmaker').runSEMakeFromNode()\"",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "main": "src/background.cjs",
  "dependencies": {
    "vue": "3.5.44",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5",
    "less": "4.9.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11"
  },
  "build": {
    "appId": "com.kcsimulator.app",
    "productName": "KCSimulator",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "src/background.cjs",
      "package.json"
    ],
    "win": {
      "icon": "public/favicon.ico",
      "target": "portable"
    }
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
